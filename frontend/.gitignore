.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Python packaging
*.egg-info/
dist/
build/
.eggs/

# Pytest
.pytest_cache/

# Coverage
.coverage
htmlcov/

